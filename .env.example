# --- Database ---
# Leave DATABASE_URL empty in development: an embedded Postgres (PGlite) is stored in ./.data/pglite
# In production use a real Postgres: postgres://user:pass@host:5432/wozabet
DATABASE_URL=

# --- Security (REQUIRED in production) ---
AUTH_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# --- Odds data ---
# Leave API_FOOTBALL_KEY empty to use the built-in mock feed (fake fixtures, all sports)
API_FOOTBALL_KEY=
# Comma-separated API-Football league ids to import (e.g. 39=EPL, 2=Champions League, 288=South African PSL). Empty = all
API_FOOTBALL_LEAGUES=39,2,140,288
# API-Football bookmaker id used as the price reference (8 = Bet365)
API_FOOTBALL_BOOKMAKER=8

# --- Book rules ---
MARGIN=0.07
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=500000
MAX_PAYOUT_CENTS=5000000
MAX_LEGS=10
LIVE_BETTING=false
AUTO_SETTLE=false

# --- Payments (mobile wallet) ---
# Empty = deposits switched off (default). "mobile_wallet" = real provider, "sandbox" = local testing only (refused in production).
PAYMENTS_PROVIDER=
# Shared secret used to verify webhook signatures (HMAC-SHA256). Get it from the provider; use a long random value for sandbox.
PAYMENT_WEBHOOK_SECRET=
MOBILE_WALLET_API_URL=
MOBILE_WALLET_API_KEY=
MOBILE_WALLET_MERCHANT_ID=
# Public https URL of this app; the provider calls $PUBLIC_BASE_URL/api/payments/webhook/<provider>
PUBLIC_BASE_URL=http://localhost:3000
MIN_DEPOSIT_CENTS=1000
MAX_DEPOSIT_CENTS=500000
MIN_WITHDRAWAL_CENTS=5000
MAX_WITHDRAWAL_CENTS=2000000

# --- Dev helpers (NEVER true in production) ---
DEMO_MODE=true
ADMIN_PHONE=0811111111
ADMIN_PASSWORD=change-me-admin
