# --- Database ---
# Leave DATABASE_URL empty in development: an embedded Postgres (PGlite) is stored in ./.data/pglite
# In production use a real Postgres: postgres://user:pass@host:5432/wozabet
DATABASE_URL=

# --- Security (REQUIRED in production) ---
AUTH_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# --- Odds data ---
# Leave API_FOOTBALL_KEY empty to use the built-in mock feed (fake fixtures, all sports)
API_FOOTBALL_KEY=
# Comma-separated API-Football league ids to import (e.g. 39=EPL, 2=Champions League, 288=South African PSL). Empty = all
API_FOOTBALL_LEAGUES=39,2,140,288
# API-Football bookmaker id used as the price reference (8 = Bet365)
API_FOOTBALL_BOOKMAKER=8
# Max API calls per sync run. Free plan: 10/min and 100/day, so keep <=9 and sync rarely. Paid plans: raise (e.g. 100).
API_FOOTBALL_MAX_REQUESTS_PER_SYNC=9
# Stop odds calls when fewer than this many daily requests remain (kept for results)
API_FOOTBALL_MIN_DAILY_REMAINING=10

# --- Odds safety ---
# Suspend prices not refreshed from the feed for this many minutes
ODDS_MAX_AGE_MINUTES=30
# Suspend prices the provider itself hasn't changed for this many minutes (0 = off)
ODDS_MAX_SOURCE_AGE_MINUTES=360
# Max worst-case loss per market across all players, in cents (N$100,000)
MAX_MARKET_LIABILITY_CENTS=10000000

# --- Book rules ---
MARGIN=0.07
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=500000
MAX_PAYOUT_CENTS=5000000
MAX_LEGS=10
LIVE_BETTING=false
AUTO_SETTLE=false

# --- Payments (mobile wallet) ---
# Empty = deposits switched off (default). "mobile_wallet" = real provider, "sandbox" = local testing only (refused in production).
PAYMENTS_PROVIDER=
# Shared secret used to verify webhook signatures (HMAC-SHA256). Get it from the provider; use a long random value for sandbox.
PAYMENT_WEBHOOK_SECRET=
MOBILE_WALLET_API_URL=
MOBILE_WALLET_API_KEY=
MOBILE_WALLET_MERCHANT_ID=
# Public https URL of this app; the provider calls $PUBLIC_BASE_URL/api/payments/webhook/<provider>
PUBLIC_BASE_URL=http://localhost:3000
MIN_DEPOSIT_CENTS=1000
MAX_DEPOSIT_CENTS=500000
MIN_WITHDRAWAL_CENTS=5000
MAX_WITHDRAWAL_CENTS=2000000

# --- KYC document storage (never inside the project folder) ---
# "s3" = any S3-compatible store (AWS S3, Cloudflare R2, MinIO…). "local" = a folder on disk.
# Dev default: local, in ~/.wozabet/kyc-dev. Production: must be set explicitly.
KYC_STORAGE=
KYC_LOCAL_DIR=
KYC_S3_BUCKET=
KYC_S3_REGION=auto
# Leave empty for AWS; set for R2/MinIO/Spaces, e.g. https://<account>.r2.cloudflarestorage.com
KYC_S3_ENDPOINT=
KYC_S3_ACCESS_KEY_ID=
KYC_S3_SECRET_ACCESS_KEY=
KYC_S3_FORCE_PATH_STYLE=false

# --- SMS (OTP codes at sign-up and for withdrawals) ---
# Dev default: "console" (codes are printed in the server log). Production: must be set, e.g. "twilio".
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: a Twilio number or an approved alphanumeric sender ID
SMS_FROM=

# --- Request security ---
# true only when the app sits behind your own load balancer/reverse proxy that sets X-Forwarded-For (needed for per-IP rate limits)
TRUST_PROXY=false
# Extra origins allowed to make API writes (comma-separated), e.g. https://www.wozabet.na
ALLOWED_ORIGINS=

# --- Dev helpers (NEVER true in production) ---
DEMO_MODE=true
# Fake fixtures when there is no API key. Default: on in development, off in production.
MOCK_FEED=
ADMIN_PHONE=0811111111
ADMIN_PASSWORD=change-me-admin
